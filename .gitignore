# Terraform state — contains resource details and any sensitive values
*.tfstate
*.tfstate.*
*.tfstate.backup

# Saved plan files
tfplan
*.tfplan

# Provider binaries and module cache (.terraform.lock.hcl SHOULD be committed)
.terraform/

# Local variable values — admin_cidr and key paths are personal
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Override files, usually local experiments
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Downloaded cluster credentials (kubeconfig_retrieval_commands writes these)
*.kubeconfig
kubeconfig

# Third-party manifests fetched while following the lessons — the lessons
# apply these straight from their upstream URLs, so they are never vendored
# (e.g. the ingress-nginx controller bundle in Module 6)
deploy.yaml

# Helm build output — the chart source belongs in git, the signed package
# belongs in the registry. .prov files are signatures over a specific archive,
# so they are only meaningful next to the .tgz they were generated with.
*.tgz
*.tgz.prov
dist/
rendered.yaml

# Exported OpenPGP keyrings. These live in ~/.gnupg by design; the pattern is
# here so a stray copy inside the repo can never be committed.
*.gpg
!*.pub.gpg

# Crash logs
crash.log
crash.*.log

# CLI config
.terraformrc
terraform.rc

# Editor/OS noise
.DS_Store
*.swp

# Webshop lab (AWS/kubeadm/k8/helm/webshop): local state and Python build
# output. chart/charts/*.tgz (downloaded Helm dependencies) is already covered
# by *.tgz above - Chart.lock pins them and is committed.
.lab-state/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

HANDOFF.md