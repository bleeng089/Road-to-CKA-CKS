  {
   "type": "timeseries",
   "title": "Request rate",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", k8s_namespace_name=~\"$namespace\", service_name=~\"$service\", service_version=~\"$version\", k8s_pod_name=~\"$pod\"}[$__rate_interval]))",
     "legendFormat": "{{service_name}}",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "5xx ratio",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", k8s_namespace_name=~\"$namespace\", service_name=~\"$service\", service_version=~\"$version\", k8s_pod_name=~\"$pod\", http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", k8s_namespace_name=~\"$namespace\", service_name=~\"$service\", service_version=~\"$version\", k8s_pod_name=~\"$pod\"}[$__rate_interval]))) / sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", k8s_namespace_name=~\"$namespace\", service_name=~\"$service\", service_version=~\"$version\", k8s_pod_name=~\"$pod\"}[$__rate_interval]))",
     "legendFormat": "{{service_name}}",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 3
