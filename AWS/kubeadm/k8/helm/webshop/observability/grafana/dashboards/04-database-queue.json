  {
   "type": "timeseries",
   "title": "Connections used vs pool size",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (db_client_connection_pool_name, k8s_pod_name) (db_client_connection_count{db_client_connection_pool_name=~\"$pool\", db_client_connection_state=\"used\"})",
     "legendFormat": "used {{k8s_pod_name}}",
     "refId": "A",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (db_client_connection_pool_name) (db_client_connection_max{db_client_connection_pool_name=~\"$pool\"})",
     "legendFormat": "max per pod {{db_client_connection_pool_name}}",
     "refId": "B",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
