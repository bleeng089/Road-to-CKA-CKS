     "expr": "(time() - max by (queue) (rabbitmq_detailed_queue_head_message_timestamp{queue=~\".*fulfillment\"} > 0)) and max by (queue) (rabbitmq_detailed_queue_messages_ready{queue=~\".*fulfillment\"}) > 0",
     "legendFormat": "{{queue}}",
     "refId": "A",
     "range": true,
