  {
   "type": "timeseries",
   "title": "Pending pods",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Pending\"}) > 0",
     "legendFormat": "{{pod}}",
     "refId": "A",
     "range": true,
     "instant": false
