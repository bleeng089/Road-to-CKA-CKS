  },
  {
   "type": "timeseries",
   "title": "HPA observed CPU utilisation (% of request)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_target_metric{namespace=~\"$namespace\", metric_name=\"cpu\", metric_target_type=\"utilization\"})",
     "legendFormat": "{{horizontalpodautoscaler}}",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "x": 8,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "id": 14
  },
  {
   "type": "timeseries",
   "title": "Node CPU used / allocatable",
   "description": "All pods on the node, every namespace: is the node itself out of CPU?",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (node) (rate(node_cpu_usage_seconds_total[$__rate_interval])) / sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
     "legendFormat": "{{node}}",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "x": 16,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "id": 15
  },
