     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name, error_type) (rate(otel_sdk_exporter_log_exported_total{error_type!=\"\"}[$__rate_interval]))",
     "legendFormat": "log export error {{service_name}} {{error_type}}",
     "refId": "C",
     "range": true,
     "instant": false
