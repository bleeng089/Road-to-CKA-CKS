  {
   "type": "timeseries",
   "title": "Collector: accepted per signal",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__rate_interval]))",
     "legendFormat": "spans/s",
     "refId": "A",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[$__rate_interval]))",
     "legendFormat": "metric points/s",
     "refId": "B",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[$__rate_interval]))",
     "legendFormat": "log records/s",
     "refId": "C",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
