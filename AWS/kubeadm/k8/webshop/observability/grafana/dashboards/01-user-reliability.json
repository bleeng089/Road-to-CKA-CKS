  {
   "type": "timeseries",
   "title": "Journey duration (submit -> fulfilled or deadline)",
   "description": "Percentiles are aggregates of many journeys. Each exemplar dot is ONE journey: click it to open that journey's trace - a representative, not an explanation of every slow one.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(webshop_synthetic_journey_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A",
     "range": true,
     "instant": false,
     "exemplar": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(webshop_synthetic_journey_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B",
     "range": true,
     "instant": false,
     "exemplar": true
    },
    {
     "datasource": {
      "type": "prometheus",
